#!/usr/bin/env python3
import json
import sys

base = json.loads({{ include ".chezmoitemplates/claude-settings.json" | toJson }})

try:
    current = json.load(sys.stdin)
except ValueError:
    current = {}

if "model" in current:
    base["model"] = current["model"]

json.dump(base, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
